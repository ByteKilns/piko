DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
AUTH_SECRET="generate-with-npx-auth-secret"
GEMINI_API_KEY="your-gemini-api-key"
# Vercel Blob store for app release APKs (auto-set on Vercel once a Blob store is linked)
BLOB_READ_WRITE_TOKEN=
# Comma-separated emails allowed to publish mobile app updates from Settings
APP_RELEASE_ADMIN_EMAILS=
# AI budget planner: off | mock | live. Phase 1 only ships the local preview,
# so leave it off until the AI call lands.
AI_BUDGET_PLANNER=off
